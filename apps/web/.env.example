# 근태 데이터 소스. 기본 fixture. 운영은 http(접근법 A — 근태관리 읽기 전용 API).
ATTENDANCE_SOURCE=fixture        # fixture | http
# http 일 때: 근태관리(Fastify+SQLite, Railway) 읽기 전용 API + AGENT_READ_TOKEN
ATTENDANCE_API_URL=              # 예: https://perfect-attendance.up.railway.app
ATTENDANCE_API_TOKEN=           # 근태관리의 AGENT_READ_TOKEN 과 동일 (integrations/README.md)

# 에이전트 DB (별도 Supabase 프로젝트 — 근태관리 키 아님!)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # 서버 전용 (tool_calls/briefings/store_settings 쓰기, 온보딩)

# 에이전트 루프 (작업 #6)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 아침 브리핑 크론 (작업 #8)
CRON_SECRET=

# 매직링크 콜백 절대 URL (배포 시). 로컬은 http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
